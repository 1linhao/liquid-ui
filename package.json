{
  "name": "@liqui/liquid-ui",
  "version": "0.1.0",
  "description": "Framework-light Liquid Glass design system with a Vue 2 adapter.",
  "keywords": ["liquid-glass", "design-system", "vue2", "ui-components", "framework-agnostic"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/1linhao/liquid-ui.git" },
  "homepage": "https://1linhao.github.io/liquid-integration-lab/?mode=light&palette=blue#components",
  "bugs": { "url": "https://github.com/1linhao/liquid-ui/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./vue2": {
      "types": "./dist/vue2.d.ts",
      "import": "./dist/vue2.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./styles/base.css": "./dist/styles/base.css",
    "./styles/components.css": "./dist/styles/components.css",
    "./styles/utilities.css": "./dist/styles/utilities.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "core.js",
    "dom.js",
    "vue2.js",
    "styles.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "npm run test && npm run build && node scripts/check-exports.mjs"
  },
  "peerDependencies": {
    "vue": ">=2.6.0 <3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=18"
  }
}
